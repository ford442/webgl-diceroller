{
    "dependencies": {
        "three": "^0.181.2"
    },
    "scripts": {
        "dev": "vite",
        "prepare": "husky",
        "build": "npm run build:wasm && vite build",
        "build:js": "node scripts/check-wasm-artifacts.mjs && node scripts/generate-pwa-icons.mjs && vite build",
        "build:js:allow-missing-wasm": "node scripts/check-wasm-artifacts.mjs --allow-missing-wasm && node scripts/generate-pwa-icons.mjs && vite build",
        "check:bundle-size": "node scripts/check-bundle-size.mjs",
        "check:deploy-size": "node scripts/check-deploy-size.mjs",
        "check:cycles": "madge --circular --extensions js,ts src/",
        "verify:bundle-loading": "node scripts/verify-bundle-loading.mjs",
        "audit:prop-colliders": "node scripts/prop-collider-audit.mjs",
        "verify:pwa-isolation": "node scripts/verify-pwa-isolation.mjs",
        "verify:production-isolation": "node scripts/verify-production-isolation.mjs",
        "baselines:update": "UPDATE_BASELINES=1 node scripts/render-regression.mjs --update-baselines",
        "build_colab": "npm run build:wasm_colab && vite build",
        "preview": "vite preview",
        "build:wasm": "bash src/wasm/build.sh",
        "build:wasm:debug": "bash src/wasm/build.sh --debug",
        "build:wasm_colab": "bash src/wasm/build_colab.sh",
        "wasm:clangd-db": "bash src/wasm/generate-clangd-db.sh",
        "convert:dice": "node scripts/convert-dice-to-glb.mjs",
        "convert:props": "node scripts/convert-props.mjs",
        "optimize:fallback-jpgs": "node scripts/reencode-fallback-jpgs.mjs",
        "verify:worker-physics": "node scripts/verify-worker-physics.mjs",
        "verify:worker-replay": "node scripts/verify-worker-replay.mjs",
        "verify:godrays": "node scripts/verify-godrays.mjs",
        "verify:clutter-unification": "node scripts/verify-clutter-unification.mjs",
        "verify:wasm-primitives": "node scripts/verify-wasm-primitives.mjs",
        "verify:wasm-interaction": "node scripts/verify-wasm-interaction.mjs",
        "verify:render-regression": "node scripts/render-regression.mjs && node scripts/compare-render-baseline.mjs",
        "verify:renderer-factory": "tsx scripts/verify-renderer-factory.mjs",
        "typecheck": "tsc --noEmit",
        "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:debug": "node tests/debug.js",
        "test:lamp": "node tests/lamp.js",
        "test:cauldron": "node tests/cauldron.js",
        "test:flute": "node tests/flute.js",
        "test:playingcards": "node tests/playingcards.js",
        "test:breadloaf": "node tests/breadloaf.js",
        "test:dicecup": "node tests/dicecup.js",
        "test:mobile-touch": "node tests/mobile-touch.js",
        "test:unit": "vitest run",
        "test:unit:coverage": "vitest run --coverage",
        "test:share-roll-replay": "node tests/share-roll-replay.js",
        "test:wasm-authoritative": "node tests/wasm-authoritative.js",
        "test:wasm-gameplay-loop": "node tests/wasm-gameplay-loop.mjs",
        "test:a11y": "node tests/a11y.js",
        "test:solver": "bash src/wasm/build_solver_test.sh",
        "signal:dev": "npm --prefix signaling run dev",
        "signal:deploy": "npm --prefix signaling run deploy"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^9.39.5",
        "@gltf-transform/core": "^4.1.0",
        "@gltf-transform/extensions": "^4.1.0",
        "@gltf-transform/functions": "^4.1.0",
        "@types/node": "^22.20.1",
        "@types/three": "^0.181.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitest/coverage-v8": "^4.1.11",
        "basisu": "^1.16.3",
        "convex-hull": "^1.0.3",
        "draco3dgltf": "^1.5.7",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fast-check": "^4.10.0",
        "globals": "^17.7.0",
        "happy-dom": "^20.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "madge": "^8.0.0",
        "playwright": "^1.58.2",
        "prettier": "^3.9.5",
        "sharp": "^0.35.1",
        "tsx": "^4.23.12",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "workbox-window": "^7.4.1"
    },
    "lint-staged": {
        "*.{js,mjs,ts}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
