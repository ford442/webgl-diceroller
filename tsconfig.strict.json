{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": false,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "WebWorker"],
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/types/**/*.d.ts", "src/global.d.ts"],
    "exclude": ["node_modules", "dist", "public"]
}
