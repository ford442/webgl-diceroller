{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": false,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "WebWorker"],
        "types": ["node"]
    },
    "include": [
        "src/types/**/*.d.ts",
        "src/wasm/physicsTypes.d.ts",
        "src/wasm/physicsFlags.ts",
        "src/wasm/workerLayout.ts",
        "src/wasm/workerCommands.ts",
        "src/wasm/staticColliders.ts",
        "src/wasm/seededThrowParams.ts",
        "src/roll/**/*.ts",
        "src/net/Protocol.ts",
        "src/net/SignalingClient.ts",
        "src/core/AppEvents.ts",
        "src/core/AppContext.ts",
        "src/core/FrameScheduler.ts",
        "src/core/RendererFactory.ts"
    ],
    "exclude": ["node_modules", "dist", "public"]
}
