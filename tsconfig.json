{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": true,
        "allowJs": true,
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "WebWorker"],
        "types": ["node"]
    },
    "files": ["src/global.d.ts"],
    "include": [
        "src/**/*.{js,ts,d.ts}",
        "src/*.{js,ts,d.ts}",
        "scripts/render-regression.mjs",
        "scripts/compare-render-baseline.mjs",
        "scripts/verify-worker-physics.mjs",
        "scripts/verify-godrays.mjs",
        "scripts/verify-wasm-primitives.mjs",
        "tests/**/*.js"
    ],
    "exclude": ["node_modules", "dist", "public"]
}
