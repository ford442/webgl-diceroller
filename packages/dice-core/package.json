{
    "name": "dice-core",
    "version": "0.1.0",
    "private": true,
    "description": "Headless dice engine: notation, dice-set format, seeded throws and the WASM physics bridge. No Three.js, no DOM.",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "source": "./src/*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}
