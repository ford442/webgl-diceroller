{
    "name": "dice-core",
    "version": "0.1.0",
    "private": true,
    "description": "Headless dice engine: notation, seeded throws, WASM physics bridge and rollHeadless(). No Three.js, no DOM.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "fixtures",
        "golden"
    ],
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "source": "./src/node.ts",
            "types": "./src/node.ts",
            "default": "./dist/node.js"
        },
        "./fixtures/*": "./fixtures/*",
        "./golden/*": "./golden/*",
        "./*": {
            "source": "./src/*.ts",
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}
